# ─── Core ────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=console                        # console | json  (json in production)
SERVICE_VERSION=0.0.0
GIT_COMMIT=unknown

# ─── PostgreSQL 17 + pgvector 0.8.5 ─────────────────────────────────────────
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=forgeops
POSTGRES_PORT=5432
# The two-role arrangement (§6.4, §6.7). The application connects as `forgeops_app`,
# which `0007` REVOKEs UPDATE/DELETE/TRUNCATE on `audit_events` from; migrations
# connect as `forgeops_migrator`, which owns the schema. A single-role deployment
# silently defeats audit immutability, so `scripts/check-db-roles.py` fails the build
# when the split is not in effect. Migration `0002` creates both roles with no
# password; `scripts/postgres-init/10-forgeops-roles.sh` grants LOGIN and these local
# passwords. Replace both before any deployment that is not a laptop.
FORGEOPS_APP_DB_PASSWORD=change-me-locally
FORGEOPS_MIGRATOR_DB_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://forgeops_app:change-me-locally@postgres:5432/forgeops
DATABASE_POOL_SIZE=10
# Query-time HNSW recall knob (Research §A0a). Never baked into the index.
PGVECTOR_HNSW_EF_SEARCH=40

# ─── Redis (vector search required for the L2 semantic cache) ───────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_SEMANTIC_INDEX=idx:llmc:l2

# ─── Backend HTTP ───────────────────────────────────────────────────────────
BACKEND_PORT=8000
# The HOST port the agent's mTLS listener is published as. Distinct from AGENT_TLS_PORT, which is
# what that listener binds inside its container; one name for both would move the container port
# too and leave the mapping pointing at nothing.
AGENT_TLS_HOST_PORT=8443
FRONTEND_PORT=3000
OPA_PORT=8181
API_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=http://localhost:3000

# ─── MCP Gateway (0.5) ──────────────────────────────────────────────────────
MCP_OIDC_ISSUERS=https://auth.localhost/application/o/forgeops/
MCP_OIDC_AUDIENCE=forgeops-mcp-gateway
MCP_OIDC_JWKS_TTL_SECONDS=600
MCP_CACHE_MAX_TTL_MS=300000               # clamps any server-declared ttlMs
MCP_SERVER_REGISTRY_PATH=config/mcp-servers.yaml
MCP_AGENT_BLAST_RADIUS=read_only          # read_only | workspace | infrastructure
OPA_URL=http://opa:8181

# ─── Model routing (0.9) ────────────────────────────────────────────────────
MODEL_TIER_CONFIG_PATH=config/model-tiers.yaml
CB_FAILURE_THRESHOLD=5                    # phases.md 0.9: 5 failures
CB_WINDOW_SECONDS=30                      # ... within 30s -> OPEN
CB_OPEN_SECONDS=60                        # ... HALF-OPEN after 60s
SEMANTIC_CACHE_THRESHOLD=0.95             # Research §A0c: similarity > 0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL_ID=voyage-code-3
EMBEDDING_DIMS=1536                       # SETTLED (D-2): must equal the pgvector column dimension
AI_RATE_LIMIT_CAPACITY=20                 # per verified OIDC sub + route
AI_RATE_LIMIT_REFILL_PER_SECOND=0.2
AI_RATE_LIMIT_FAIL_MODE=fail_closed       # only supported Phase 0 mode for costly completion
OUTBOUND_HTTP_TIMEOUT_SECONDS=60

# ─── BYO-Key (0.9) ──────────────────────────────────────────────────────────
LLM_KEY_RESOLVER=env                      # env | infisical
LLM_KEY_OPENAI=sk-placeholder
LLM_KEY_ANTHROPIC=sk-ant-placeholder
LLM_KEY_XAI=xai-placeholder
LLM_KEY_GOOGLE=placeholder
LLM_KEY_DEEPSEEK=placeholder
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_BASE_URL=https://api.x.ai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# The `ollama` Compose service, which is the ONLY endpoint in config/model-tiers.yaml a fresh
# clone can actually reach: every hosted endpoint needs one of the placeholder LLM_KEY_* values
# above. This said `http://host.docker.internal:11434/v1` when no self-hosted service existed,
# which resolves only on Docker Desktop and pointed at a server nobody was running. A host-side
# test run overrides it with the published port below.
SELF_HOSTED_BASE_URL=http://ollama:11434/v1
# The SECOND model server, a separate process in a separate container sharing the weights volume.
# It is what makes the cascade demonstrable: the `self_hosted` tier's secondary used to name the
# same base URL as its primary, so stopping one server left the cascade nowhere to fall back to.
SELF_HOSTED_SECONDARY_BASE_URL=http://ollama-secondary:11434/v1
# The model tag the self-hosted server has actually pulled, expanded into
# config/model-tiers.yaml's `qwen3-coder-next` endpoint. It is configuration and not a design
# constant: the tier YAML names a SLOT in the cascade, and which weights sit in that slot is a
# property of the deployment. An unset value is a startup error rather than a silent default,
# because a request naming a model the server does not have comes back as a 404 that reads like
# a routing bug.
SELF_HOSTED_MODEL_ID=qwen2.5-coder:1.5b
# The embedding model behind the L2 semantic cache. Tagged explicitly (`:latest` rather than
# bare) because the container healthcheck greps `ollama list`, which always prints a tag.
SELF_HOSTED_EMBEDDING_MODEL_ID=bge-m3:567m
# Compose-only, like the other *_PORT keys: the published port of the `ollama` service, bound to
# 127.0.0.1 (§14.2). A host process reaches the model at http://127.0.0.1:${OLLAMA_PORT}/v1.
OLLAMA_PORT=11434
# The secondary's published port. A host process reaches it at http://127.0.0.1:${OLLAMA_SECONDARY_PORT}/v1.
OLLAMA_SECONDARY_PORT=11435
INFISICAL_URL=http://infisical:8080       # only used when LLM_KEY_RESOLVER=infisical
INFISICAL_CLIENT_ID=placeholder
INFISICAL_CLIENT_SECRET=placeholder
INFISICAL_PROJECT_ID=placeholder

# ─── GitOps (0.6) ───────────────────────────────────────────────────────────
GITHUB_TOKEN=placeholder                  # Phase 0 EnvTokenSource; GitHub App is Phase 1 (OQ-7)
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REPO=parag8487/ForgeOps            # owner/name for the 0.6 PR flow
GIT_AUTHOR_NAME=forgeops-agent
GIT_AUTHOR_EMAIL=agent@forgeops.invalid
GIT_BRANCH_PREFIX=forgeops/
GIT_PR_POLL_INTERVAL_SECONDS=15
GIT_PR_POLL_TIMEOUT_SECONDS=900

# ─── OpenTofu (0.8) ─────────────────────────────────────────────────────────
TOFU_BINARY=tofu
TOFU_VERSION=1.12.5
TOFU_TIMEOUT_SECONDS=300
TOFU_KILL_GRACE_SECONDS=10
TF_PLUGIN_CACHE_DIR=/var/cache/tofu/plugins

# ─── Agent ──────────────────────────────────────────────────────────────────
# No longer empty (design §13.1). Phase 0 left this blank so the connection manager
# stayed disabled and `agent doctor` could report "no URL" distinctly; Phase 1 §1.1
# gives it a real endpoint to dial, and `session.ErrUnpaired` is what now distinguishes
# "no URL" from "no token" (task 8.3).
AGENT_BACKEND_WSS_URL=wss://localhost:8000/api/v1/ws/agent
AGENT_SHUTDOWN_TIMEOUT_SECONDS=15
AGENT_MCP_TRANSPORT=stdio                 # stdio | http

# ─── Telemetry (propagation only in Phase 0; OTel SDK is Phase 3) ──────────
TRACE_PROPAGATION_ENABLED=true

# ─── Frontend (NEXT_PUBLIC_* is shipped to the browser: never a secret) ────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=ForgeOps
NEXT_PUBLIC_OIDC_LOGIN_PATH=/api/v1/auth/login
NEXT_PUBLIC_SSE_TIMEOUT_MS=600000
# Where the backend sends a BROWSER once the OIDC code exchange succeeds. Distinct from
# OIDC_REDIRECT_URL, which is where the IdP sends it: the IdP must reach the backend, because
# that is where the client secret and the pending PKCE verifier live, but the backend callback
# answers JSON — so a browser would be left on a token document instead of the application.
# Only ever joined with a same-origin absolute path, so it cannot become an open redirect.
FRONTEND_BASE_URL=http://localhost:3000

# ════════════════════════════════════════════════════════════════════════════
# Phase 1 additions (design §13.1). Every secret below is a PLACEHOLDER: this file
# is committed, and `scripts/init-env.sh` copies it to the untracked `.env` where
# real values belong. `change-me-locally` and `placeholder` are deliberately not
# shaped like any real credential, so secret scanners stay quiet on our own content.
# ════════════════════════════════════════════════════════════════════════════

# ─── Auth (§1.11) ────────────────────────────────────────────────────────────
# Quoting alone did not stop a generic credential heuristic reading
# `host:port/path` as `key:secret`, so the value names localhost. Inside Compose
# the backend reaches the IdP at the service hostname `authentik-server` on the
# same port and path; task 6.3 sets that in the deployed environment. This is a
# public OIDC discovery URL, never a secret.
OIDC_ISSUER="http://localhost:9000/application/o/forgeops/"
OIDC_APP_AUDIENCE=forgeops-api            # DISTINCT from MCP_OIDC_AUDIENCE by design
OIDC_CLIENT_ID=forgeops-frontend
OIDC_CLIENT_SECRET=change-me-locally
OIDC_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback
# Where a BROWSER reaches the IdP, when that is not where the backend reaches it. Empty means they
# are the same, which is correct for a single host and is the default here.
#
# Set it when the two genuinely differ. Inside Compose the backend resolves `authentik-server:9000`
# and a browser on the host cannot; the host's published `localhost:9000` is not reachable from
# inside a container, and the published ports are bound to 127.0.0.1 on purpose so widening them is
# not an option. There is no single host:port both sides can use, so only the authorization redirect
# is rewritten to this value -- discovery, token and JWKS stay on OIDC_ISSUER, which is also what
# keeps the token's `iss` claim equal to it.
OIDC_PUBLIC_BASE_URL=
SESSION_COOKIE_NAME=forgeops_session
SESSION_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=1209600
CERBOS_URL=http://cerbos:3592
# Published on 127.0.0.1 only (§14.2). Task 6.4.
CERBOS_HTTP_PORT=3592
AUTHENTIK_SECRET_KEY=change-me-locally
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-locally
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-locally
# Server-side Authentik variables (task 6.3). Absent until now because the backend only
# ever needed the client half; the container needs its own database and admin identity.
#
# The double-underscore names are Authentik's own, and they are used verbatim ON PURPOSE:
# Compose interpolation does not read `env_file`, so a `${FORGEOPS_NAME}` mapped in the
# compose `environment:` block would be EMPTY on a fresh clone with no `.env`. Naming the
# variables what the container already reads means env_file delivers them directly, with
# no interpolation to go silently blank. `scripts/postgres-init/20-authentik-database.sh`
# reads the same names.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@forgeops.invalid
AUTHENTIK_PORT=9000
# Authentik shares the Postgres SERVER and gets its own DATABASE — see
# scripts/postgres-init/20-authentik-database.sh for why sharing the database would make
# `alembic revision --autogenerate` propose dropping ninety foreign tables.
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=change-me-locally
# A separate logical Redis database: Authentik and the backend both use unprefixed keys,
# so a FLUSHDB from either would otherwise take out the other.
AUTHENTIK_REDIS__DB=1

# ─── Agent pairing and envelopes (§1.1) ─────────────────────────────────────
PAIRING_CODE_TTL_SECONDS=300
PAIRING_CODE_MAX_ATTEMPTS=5
PAIRING_CODE_ALPHABET=0123456789ABCDEFGHJKMNPQRSTVWXYZ   # Crockford base32, no I/L/O/U
PAIRING_RATE_LIMIT_PER_IP_PER_MINUTE=10
# design.md §14.6's global exchange bucket: the bound that binds a DISTRIBUTED attacker,
# which the per-IP cap above cannot. Total attempts across one PAIRING_CODE_TTL_SECONDS
# window; 600 is the value §14.6's arithmetic uses (P(success) ≈ 5.6e-6).
PAIRING_RATE_LIMIT_GLOBAL_PER_WINDOW=600
DEVICE_CERT_TTL_HOURS=24
DEVICE_CERT_RENEW_BEFORE_HOURS=6
ENVELOPE_MAX_AGE_SECONDS=300
ENVELOPE_CLOCK_SKEW_SECONDS=60
ENVELOPE_PEPPER=change-me-locally         # HMAC pepper for code/token storage
# Both are EMPTY here and are populated by scripts/init-ca.sh into the untracked
# `.env`; key material is never committed. The explicit "" matters: a bare
# `KEY=` followed by a newline lets a generic credential heuristic match across
# the line break and report the NEXT variable's value as this one's secret.
INTERNAL_CA_CERT_PEM=""
INTERNAL_CA_KEY_PEM=""
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=90

# ─── Analysis and indexing (§1.3) ───────────────────────────────────────────
SCAN_MAX_FILE_SIZE_BYTES=1048576          # phases.md §1.3 "skip binaries >1MB"
SCAN_WATCH_DEBOUNCE_MS=250
SCAN_PARSER_CONCURRENCY=0                 # 0 = min(GOMAXPROCS, 8)
CHUNK_TARGET_TOKENS=512                   # Research §C10
CHUNK_OVERLAP_TOKENS=128                  # Research §C10
SUMMARY_TARGET_TOKENS=1024                # Research §C10
# Which pgvector table holds this deployment's vectors (D-48). `voyage` is 1536-d in
# `embeddings`; `bge_m3` is 1024-d in `embeddings_local`. A project reads exactly one, so the two
# can never be compared by accident.
#
# `bge_m3` IS THE DEFAULT BECAUSE IT IS THE ONE A FRESH CLONE CAN REACH — the same reasoning as
# GENERATION_TIER below. `voyage` needs LLM_KEY_VOYAGE, this file ships it as `placeholder`, and
# with `voyage` selected every scan persisted the tree and the contents with `vectors_written = 0`
# and the HNSW index on `embeddings_local` had never held a row. Set this to `voyage` once a real
# key is configured; the 1536-d column and its index are unchanged and waiting.
#
# The model must be 1024-d. `SelfHostedChunkEmbedder` refuses any other width by name rather than
# letting the INSERT fail per row — `nomic-embed-text` is 768 and was the previous default here.
EMBEDDING_BACKEND=bge_m3                   # voyage | bge_m3  (selects the table, D-48)
EMBEDDING_MODEL_ID_LOCAL=bge-m3
EMBEDDING_DIMS_LOCAL=1024                 # must equal embeddings_local's column
LLM_KEY_VOYAGE=placeholder
VOYAGE_BASE_URL=https://api.voyageai.com/v1
RERANK_MODEL=voyage-rerank-2              # Research §C10, from P1
RETRIEVAL_OVERFETCH_FACTOR=3              # Research §C10 "over-retrieve 3x"
RETRIEVAL_TOP_K=12

# ─── Generation (§1.5) ──────────────────────────────────────────────────────
GENERATION_MAX_ITERATIONS=3               # typed Literal[3]; the config refuses any other value
JUDGE_TIER=medium_value
JUDGE_PROMPT_VERSION=1
TEMPLATE_LIBRARY_PATH=src/generation/templates
# Which of §11.7's six tiers a generation run asks for. `self_hosted` because it is the only
# chain whose endpoints a fresh clone can reach (see SELF_HOSTED_BASE_URL); a deployment that
# has real LLM_KEY_* values sets `high_coding`, which §11.5.4 assigns to artifact generation.
GENERATION_TIER=self_hosted

# ─── Governance, policy, audit (§1.7 §1.9 §1.10) ────────────────────────────
GOVERNANCE_POLICY_PACKAGE=forgeops/governance
POLICY_BUNDLE_REFRESH_SECONDS=300
APPROVAL_TTL_SECONDS=604800               # a pending change-set expires after 7 days
AUDIT_ADVISORY_LOCK_KEY=forgeops-audit

# ─── Secrets (§1.8) ─────────────────────────────────────────────────────────
SECRET_BACKEND=infisical                  # infisical | local
LOCAL_SECRET_SEAL_KEY=change-me-locally   # AES-256-GCM, SECRET_BACKEND=local only

# ─── Tasks (§7.10) ──────────────────────────────────────────────────────────
TASK_DISPATCHER=arq                       # arq | inline
ARQ_QUEUE_NAME=forgeops
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT_SECONDS=900

# ─── Database pooling (§6.7) ────────────────────────────────────────────────
DATABASE_POOLER_MODE=session              # session | transaction (transaction => stmt cache 0)
ALEMBIC_DATABASE_URL=postgresql+asyncpg://forgeops_migrator:change-me-locally@postgres:5432/forgeops

# ─── Agent-side (§1.1 §1.3 §1.5) ────────────────────────────────────────────
AGENT_STATE_DIR=
AGENT_CREDENTIAL_STORE=auto               # auto | keychain | file
AGENT_IDENTITY_PROVIDER=paired_device     # paired_device | spiffe_workload
SPIFFE_ENDPOINT_SOCKET=                   # only for spiffe_workload
AGENT_JOURNAL_MAX_BYTES=67108864          # D-41 offline queue bound (NFR-18); 0 disables
AGENT_JOURNAL_MAX_AGE_HOURS=168           # records older than this are dropped on load
AGENT_JOURNAL_DRAIN_BATCH=64              # records per drain round trip
AGENT_TRIVY_BINARY=trivy
AGENT_VALIDATOR_TIMEOUT_SECONDS=120

# ─── Agent connection instructions (the Onboarding screen reads these) ───────
# The Onboarding and Pairing screens print the exact command to run, including --backend, which the
# backend computes from BACKEND_PORT above. AGENT_CONNECT_HOST overrides "localhost" when the agent
# runs on a different machine from the backend; it is a SETTING and never the request's Host header,
# because building connect instructions from a caller-supplied header would let anyone who can reach
# the API choose where the next agent sends its device token.
AGENT_CONNECT_HOST=
AGENT_CONNECT_TLS=false
# The release the UI offers for download. Empty means this deployment publishes none, and the UI says
# so rather than linking to something that may not exist. Deliberately not "latest": a link that
# follows the newest tag can hand a user an agent newer than the backend it is pairing with.
AGENT_RELEASE_TAG=v0.1.0
AGENT_DOWNLOAD_BASE_URL=https://github.com/parag8487/ForgeOps/releases/download
